+            inner_tar_path = os.path.join(
+                archive_path,
+                os.path.splitext(os.path.basename(archive_path))[0],
+            )
+            if archive_path.endswith(".tar") and os.path.isfile(inner_tar_path):
+                # patool strips both suffixes from .tar.xz, while archive_path
+                # retains .tar. Give the inner archive an explicit suffix and
+                # keep it from colliding with its top-level directory.
+                renamed_tar_path = f"{inner_tar_path}.tar"
+                shutil.move(inner_tar_path, renamed_tar_path)
+                try:
+                    patoolib.extract_archive(
+                        renamed_tar_path,
+                        outdir=archive_path,
+                    )
+                finally:
+                    if os.path.exists(renamed_tar_path):
+                        os.remove(renamed_tar_path)
         except Exception as e:
